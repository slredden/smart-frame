// smart-frame: the Worker behind the photo frame (no custom domain, no DNS).
// URL: https://smart-frame.sredden.workers.dev
// Free plan only. No R2 (it needs a payment method on file). D1 + KV only.
// No secrets here. Secrets go GitHub secrets -> Worker via the worker-secrets workflow (PLAN.md §14).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "smart-frame",
  "account_id": "9fe5335692abfa6ffa078e497d6f77d2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../frame/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/p/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "FRAME_DB",
      "database_name": "smart-frame-db",
      "database_id": "be885d34-b163-4314-a9ea-2d7b5c2fd83b"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FRAME_PHOTOS",
      "id": "b684cd0680a34f788b508b1371e39081"
    }
  ],
  // One cron (the Free plan allows 5 per account). Calendar every run, weather every 10 min.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "BUILD_ID": "dev",
    "IDLE_MINUTES": "10",
    "PHOTO_INTERVAL_SEC": "60",
    "PHOTO_SET_MAX": "300",
    "WEATHER_LAT": "39.74",
    "WEATHER_LON": "-104.99",
    "TIME_ZONE": "America/Denver",
    // Google OAuth client id and the Access app's AUD tag (both public, set 2026-10-24).
    "GOOGLE_CLIENT_ID": "869338664734-jpienjie5r7d1f0cjtmp4bdk9c0qb481.apps.googleusercontent.com",
    "ACCESS_TEAM_DOMAIN": "https://aged-lake-40af.cloudflareaccess.com",
    // Spotify app client id (public; the secret is SPOTIFY_CLIENT_SECRET). PLAN-v2 §11.5.
    "SPOTIFY_CLIENT_ID": "08de35418963430c97f285f96f2a202b",
    "ACCESS_AUD": "2e921b75e459c3ff59a6f6db9d971045a8bb8d89780841023c58f2fa7a9b90ed" // public AUD tag, not a secret. gitleaks:allow
  },
  // Workers VPC service "ha" -> Home Assistant on reddencloud (127.0.0.1:8123) via private tunnel smart-frame-ha. PLAN-v2 §11.9.
  "vpc_services": [{ "binding": "HA", "service_id": "01a174fd-761c-78e1-94e2-96b8056b3b5b", "remote": true }],
  "observability": { "enabled": true }
}
